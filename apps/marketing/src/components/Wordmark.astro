---
type Level = 1 | 2 | 3;

/* The app's "RAS" contribution-grid wordmark. Cells are [column, row, level];
   keep them identical to apps/web/src/components/RasCodeWordmark.tsx. */
const ACTIVE_CELLS: ReadonlyArray<readonly [number, number, Level]> = [
  [0, 0, 3],
  [1, 0, 2],
  [5, 0, 3],
  [8, 0, 1],
  [9, 0, 2],
  [10, 0, 3],
  [0, 1, 2],
  [2, 1, 3],
  [4, 1, 2],
  [6, 1, 3],
  [8, 1, 2],
  [0, 2, 3],
  [1, 2, 2],
  [4, 2, 3],
  [5, 2, 2],
  [6, 2, 1],
  [8, 2, 3],
  [9, 2, 2],
  [10, 2, 1],
  [0, 3, 1],
  [2, 3, 3],
  [4, 3, 1],
  [6, 3, 3],
  [10, 3, 3],
  [0, 4, 2],
  [2, 4, 1],
  [4, 4, 2],
  [6, 4, 1],
  [8, 4, 1],
  [9, 4, 2],
  [10, 4, 3],
];

const LEVEL_COLORS: Record<Level, string> = {
  1: "var(--brand-low)",
  2: "var(--brand-medium)",
  3: "var(--brand-high)",
};

const levelByCell = new Map<string, Level>(
  ACTIVE_CELLS.map(([column, row, level]) => [`${column},${row}`, level]),
);

const CELLS = Array.from({ length: 5 }, (_, row) =>
  Array.from({ length: 11 }, (_, column) => ({ column, row })),
).flat();
---

<svg class="wordmark" viewBox="0 0 108 48" xmlns="http://www.w3.org/2000/svg" aria-label="RAS">
  {
    CELLS.map(({ column, row }) => {
      const level = levelByCell.get(`${column},${row}`);
      return (
        <rect
          x={column * 10}
          y={row * 10}
          width="8"
          height="8"
          rx="1.5"
          fill={level === undefined ? "var(--brand-empty)" : LEVEL_COLORS[level]}
        />
      );
    })
  }
</svg>

<style>
  .wordmark {
    height: 1em;
    width: auto;
    flex-shrink: 0;
  }
</style>
