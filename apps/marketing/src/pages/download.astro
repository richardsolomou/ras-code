---
import Layout from "../layouts/Layout.astro";
import { ALL_RELEASES_URL, RELEASES_URL } from "../lib/releases";

const builds = [
  { platform: "macOS", arch: "Apple Silicon", asset: "arm64.dmg", format: ".dmg" },
  { platform: "macOS", arch: "Intel", asset: "x64.dmg", format: ".dmg" },
  { platform: "Windows", arch: "x64", asset: "x64.exe", format: ".exe" },
  { platform: "Linux", arch: "x86_64", asset: "x86_64.AppImage", format: "AppImage" },
] as const;
---

<Layout title="Download — RAS Code" description="Download RAS Code for macOS, Windows, or Linux.">
  <section class="download">
    <h1>Download</h1>
    <p class="version" id="version-label">Loading latest release&hellip;</p>

    <ul class="builds">
      {
        builds.map((build) => (
          <li>
            <a href={RELEASES_URL} data-asset={build.asset}>
              <span class="platform">{build.platform}</span>
              <span class="arch">{build.arch}</span>
              <span class="format">{build.format}</span>
            </a>
          </li>
        ))
      }
    </ul>

    <p class="note">
      Older versions live on the <a href={ALL_RELEASES_URL} target="_blank" rel="noopener noreferrer"
        >GitHub releases page</a
      >. You can also run the server without installing anything: <code>npx ras-code</code>.
    </p>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, RELEASES_URL } from "../lib/releases";

  async function init() {
    const versionLabel = document.getElementById("version-label");
    const links = document.querySelectorAll<HTMLAnchorElement>("a[data-asset]");

    try {
      const release = await fetchLatestRelease();

      if (versionLabel) {
        versionLabel.textContent = release.tag_name ? `Latest release ${release.tag_name}` : "";
      }

      for (const link of links) {
        const match = (release.assets ?? []).find((asset) =>
          asset.name.endsWith(`-${link.dataset.asset}`),
        );
        link.href = match?.browser_download_url ?? RELEASES_URL;
      }
    } catch {
      if (versionLabel) versionLabel.textContent = "Could not load release info.";
    }
  }

  init();
</script>

<style>
  .download {
    flex: 1;
    width: min(880px, 100%);
    margin: 0 auto;
    padding: clamp(48px, 10vh, 96px) 24px 80px;
  }

  h1 {
    font-size: clamp(1.75rem, 5vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .version {
    margin-top: 6px;
    font-size: 14px;
    color: var(--fg-dim);
  }

  .builds {
    list-style: none;
    margin-top: 32px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .builds li + li {
    border-top: 1px solid var(--border);
  }

  .builds a {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 16px;
    background: var(--bg-card);
    transition: background 0.15s ease;
  }

  .builds a:hover {
    background: var(--bg-subtle);
  }

  .platform {
    font-weight: 500;
    min-width: 84px;
  }

  .arch {
    flex: 1;
    color: var(--fg-dim);
    font-size: 14px;
  }

  .format {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--fg-dim);
  }

  .note {
    margin-top: 24px;
    font-size: 13px;
    color: var(--fg-dim);
  }

  .note a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }

  .note a:hover {
    color: var(--fg);
  }

  .note code {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 2px 6px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--bg-card);
  }
</style>
