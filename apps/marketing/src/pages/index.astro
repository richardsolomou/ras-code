---
import Layout from "../layouts/Layout.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";
import { RELEASES_URL } from "../lib/releases";
---

<Layout>
  <section class="hero">
    <p class="eyebrow">Open source · MIT</p>

    <h1>A minimal GUI for coding agents.</h1>

    <p class="lede">
      Run Claude Code, Codex, Cursor, Grok, and OpenCode from one app — on your desktop, in a
      browser, or from your phone. Bring your own subscription.
    </p>

    <div class="actions">
      <a id="download-btn" class="btn btn-primary" href={RELEASES_URL}>
        <span id="download-label">Download</span>
      </a>
      <a class="btn btn-ghost" href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">
        View source
      </a>
    </div>

    <p class="note">
      RAS Code is a fork of <a
        href="https://github.com/pingdotgg/t3code"
        target="_blank"
        rel="noopener noreferrer">T3 Code</a
      >, maintained independently. <a href="/download">All platforms and versions</a>.
    </p>
  </section>
</Layout>

<script>
  import { fetchLatestRelease, type ReleaseAsset } from "../lib/releases";

  type Platform = { os: "mac" | "win" | "linux"; label: string };

  function detectPlatform(): Platform | null {
    const ua = navigator.userAgent;
    if (/Win/i.test(ua)) return { os: "win", label: "Download for Windows" };
    if (/Mac/i.test(ua)) return { os: "mac", label: "Download for macOS" };
    if (/Linux/i.test(ua)) return { os: "linux", label: "Download for Linux" };
    return null;
  }

  // Macs always get the arm64 build. Browsers cannot reliably tell Apple Silicon
  // from Intel (the UA lies, GPU strings lie), and a wrong guess hands an Apple
  // Silicon user a broken app. Intel users pick their build on /download.
  // Do NOT add arch detection back here.
  function pickAsset(assets: ReleaseAsset[], platform: Platform): string | null {
    const suffix =
      platform.os === "win" ? "-x64.exe" : platform.os === "mac" ? "-arm64.dmg" : ".AppImage";
    return assets.find((asset) => asset.name.endsWith(suffix))?.browser_download_url ?? null;
  }

  async function init() {
    const button = document.getElementById("download-btn") as HTMLAnchorElement | null;
    const label = document.getElementById("download-label");

    const platform = detectPlatform();
    if (!platform) return;
    if (label) label.textContent = platform.label;

    try {
      const release = await fetchLatestRelease();
      const url = pickAsset(release.assets ?? [], platform);
      if (url && button) button.href = url;
    } catch {
      // The button already points at the latest release page.
    }
  }

  init();
</script>

<style>
  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
    width: min(880px, 100%);
    margin: 0 auto;
    padding: clamp(56px, 12vh, 120px) 24px;
  }

  h1 {
    font-size: clamp(2rem, 6vw, 3rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.1;
    max-width: 20ch;
  }

  .lede {
    max-width: 56ch;
    font-size: 1.0625rem;
    color: var(--fg-muted);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 8px;
  }

  .note {
    font-size: 13px;
    color: var(--fg-dim);
  }

  .note a {
    color: var(--fg-muted);
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
  }

  .note a:hover {
    color: var(--fg);
    text-decoration-color: currentColor;
  }
</style>
