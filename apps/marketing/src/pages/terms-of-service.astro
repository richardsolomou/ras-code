---
import LegalPage from "../components/LegalPage.astro";

const sections = [
  ["introduction", "Introduction"],
  ["software", "The software is separate from the service"],
  ["accounts", "Accounts"],
  ["personal-use", "Personal use only"],
  ["content", "Your content and your providers"],
  ["acceptable-use", "Acceptable use"],
  ["availability", "No guarantees, and the service may stop"],
  ["fees", "Fees"],
  ["privacy", "Privacy"],
  ["termination", "Suspension and termination"],
  ["disclaimers", "Disclaimer of warranties"],
  ["liability", "Limitation of liability"],
  ["indemnification", "Indemnification"],
  ["third-parties", "Third-party services"],
  ["feedback", "Feedback"],
  ["law", "Governing law and disputes"],
  ["miscellaneous", "Miscellaneous"],
  ["changes", "Changes to these terms"],
  ["contact", "Contact"],
] as const;
---

<LegalPage
  title="Terms of Service — RAS Code"
  description="The terms for RAS Connect, the optional hosted service operated by Richard Solomou."
  heading="RAS Code Terms of Service"
  lede="These terms govern RAS Connect, the optional hosted service that links your devices to your own RAS Code server. The RAS Code software itself is MIT-licensed and governed by that licence, not by these terms."
  effectiveDate="2026-08-28"
  lastUpdated="2026-08-28"
