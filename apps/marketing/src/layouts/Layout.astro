---
import Wordmark from "../components/Wordmark.astro";
import { GITHUB_REPOSITORY_URL } from "../lib/site";

interface Props {
  title?: string;
  description?: string;
  pageClass?: string;
}

const {
  title = "RAS Code",
  description = "RAS Code — a minimal GUI for coding agents.",
  pageClass,
} = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <!-- Declared before any stylesheet so the browser paints its first frame on
         the matching canvas instead of flashing white into a dark page. -->
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#151515" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;500;600&family=Barlow+Semi+Condensed:wght@600&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-32x32.png" sizes="32x32" />
    <link rel="icon" type="image/png" href="/favicon-16x16.png" sizes="16x16" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body>
    <div class:list={["page", pageClass]}>
      <nav class="nav">
        <a href="/" class="brand" aria-label="RAS Code home">
          <Wordmark />
          <span>Code</span>
        </a>
        <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
      </nav>

      <main class="main">
        <slot />
      </main>

      <footer class="footer">
        <span>&copy; {new Date().getFullYear()} Richard Solomou · MIT licensed</span>
        <span class="footer-links">
          <a href="/download">Download</a>
          <a href="/legal">Legal</a>
          <a href={GITHUB_REPOSITORY_URL} target="_blank" rel="noopener noreferrer">GitHub</a>
        </span>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  /* Palette mirrors the app (apps/web/src/index.css): zinc-25 canvas in light,
     #151515 in dark, with the same primary accent and contribution-grid brand
     cells. The app follows the system appearance, so the site does too. */
  :root {
    color-scheme: light dark;
    --bg: #fcfcfc;
    --bg-card: #ffffff;
    --bg-subtle: #f4f4f5;
    --fg: #27272a;
    --fg-muted: #52525b;
    --fg-dim: #71717a;
    --fg-faint: #a1a1aa;
    --border: #e4e4e7;
    --border-strong: #d4d4d8;
    --accent: #2a2733;
    --accent-fg: #ffffff;
    --brand-empty: #ebedf0;
    --brand-low: #216e39;
    --brand-medium: #30a14e;
    --brand-high: #40c463;
    --font-sans: "Barlow", -apple-system, BlinkMacSystemFont, "Segoe UI", system-ui, sans-serif;
    --font-legend: "Barlow Semi Condensed", "Barlow", system-ui, sans-serif;
    --font-mono:
      ui-monospace, "SF Mono", "SFMono-Regular", Menlo, Consolas, "Liberation Mono", monospace;
    --radius: 0.625rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #151515;
      --bg-card: #1e1e1e;
      --bg-subtle: #1c1c1c;
      --fg: #e4e4e4;
      --fg-muted: #b4b4b4;
      --fg-dim: #999999;
      --fg-faint: #6f6f6f;
      --border: rgb(255 255 255 / 8%);
      --border-strong: rgb(255 255 255 / 16%);
      --accent: #f0c24b;
      --accent-fg: #101010;
      --brand-empty: #21262d;
      --brand-low: #006d32;
      --brand-medium: #26a641;
      --brand-high: #39d353;
    }
  }

  * {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  /* The canvas is painted from html so it is already correct while the rest of
     the document streams in. */
  html {
    background: var(--bg);
  }

  body {
    background: var(--bg);
    color: var(--fg);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.5;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img,
  svg {
    display: block;
    max-width: 100%;
  }

  /* The app's engraved legend face, used for small caps labels. */
  .eyebrow {
    font-family: var(--font-legend);
    font-weight: 600;
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--fg-dim);
  }

  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    height: 40px;
    padding: 0 18px;
    border-radius: var(--radius);
    border: 1px solid transparent;
    font-weight: 500;
    font-size: 15px;
    white-space: nowrap;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
  }

  .btn-primary {
    background: var(--accent);
    color: var(--accent-fg);
  }

  .btn-primary:hover {
    background: color-mix(in srgb, var(--accent) 88%, var(--bg));
  }

  .btn-ghost {
    border-color: var(--border);
    color: var(--fg-muted);
  }

  .btn-ghost:hover {
    border-color: var(--border-strong);
    color: var(--fg);
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 4px;
  }

  /* Entry fade for the legal documents; nothing on this site loops. */
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>

<style>
  .page {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  .nav,
  .footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    width: min(880px, 100%);
    margin: 0 auto;
    padding: 20px 24px;
    font-size: 14px;
  }

  .nav a:hover,
  .footer a:hover {
    color: var(--fg);
  }

  .nav > a:last-child,
  .footer {
    color: var(--fg-dim);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 17px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .main {
    flex: 1;
    display: flex;
    flex-direction: column;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding-top: 24px;
    padding-bottom: max(24px, env(safe-area-inset-bottom));
    font-size: 13px;
  }

  .footer-links {
    display: inline-flex;
    gap: 18px;
  }

  @media (max-width: 520px) {
    .footer {
      flex-direction: column;
      align-items: flex-start;
      gap: 12px;
    }
  }
</style>
