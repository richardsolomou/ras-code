# Required: hosted web app domains.
# The router URL is the origin users open. Stable releases deploy the `latest`
# stage, which serves both the latest channel domain and the router domain;
# nightly releases deploy the `nightly` stage, which serves only its own domain.
RAS_CODE_WEB_ROUTER_URL=https://code.example.com
RAS_CODE_WEB_LATEST_DOMAIN=code-latest.example.com
RAS_CODE_WEB_NIGHTLY_DOMAIN=code-nightly.example.com
