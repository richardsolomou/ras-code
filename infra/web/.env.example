# Required: hosted web app domains.
# The router URL is the origin users open. Stable releases deploy the `latest`
# stage, which answers on that domain under the app's path prefix; canary
# releases deploy the `canary` stage, which serves only its own domain and is
# what the router proxies to. The marketing site owns the router domain itself,
# so the stable channel is attached with Worker routes rather than a custom
# domain — which needs the zone the router domain belongs to.
# Include the path prefix the app is served under: clients bake this in as
# their hosted app URL and resolve pairing and connect links against it, while
# the stack reads only its hostname.
RAS_CODE_WEB_ROUTER_URL=https://code.example.com/app
RAS_CODE_WEB_CANARY_DOMAIN=code-canary.example.com
RAS_CODE_WEB_ZONE_ID=0123456789abcdef0123456789abcdef
