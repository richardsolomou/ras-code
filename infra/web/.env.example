# Required: hosted web app domains.
# The router URL is the origin users open. Stable releases deploy the `latest`
# stage, which serves that domain; canary releases deploy the `canary` stage,
# which serves only its own domain and is what the router proxies to.
RAS_CODE_WEB_ROUTER_URL=https://code.example.com
RAS_CODE_WEB_CANARY_DOMAIN=code-canary.example.com
