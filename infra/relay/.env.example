# Required: Relay API and managed tunnel domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves relay.<zone> in production and relay-<stage>.<zone> for personal
# stages. Use the same zone for first-level gateway and internal tunnel names
# when Universal SSL is providing the edge certificate.
RELAY_API_ZONE_NAME=example.com
RELAY_TUNNEL_ZONE_NAME=example.com

# Required: shared public hostname for path-routed managed tunnel traffic.
RELAY_TUNNEL_GATEWAY_DOMAIN=code-tunnels.example.com

# Optional: hostname prefix for internal managed tunnel records. Defaults to
# the deployment stage (`prod`, `dev-alice`, and so on).
RELAY_TUNNEL_NAMESPACE=code

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=relay.example.com

# Required: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `ras-code-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=ras-code-relay

# Required for mobile push notifications and Live Activities: Apple Push Notification service
# Get these values from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...
