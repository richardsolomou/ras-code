# Required: Relay API and gateway domains
# Production adopts retained DNS zones in your Cloudflare account. The API
# zone serves code-relay.<zone> in production and code-relay-<stage>.<zone> for personal
# stages. Use the same zone for the gateway when Universal SSL provides the
# edge certificate.
RELAY_API_ZONE_NAME=example.com
RELAY_GATEWAY_ZONE_NAME=example.com

# Required: shared public hostname for path-routed relay traffic.
RELAY_GATEWAY_DOMAIN=code-tunnels.example.com

# Optional: stable namespace for relay endpoint IDs. Defaults to the deployment
# stage (`prod`, `dev-alice`, and so on).
RELAY_ENDPOINT_NAMESPACE=code

# Optional: Relay domain override
# Set this only when the derived relay hostname should not be used.
# RELAY_DOMAIN=code-relay.example.com

# Required: Postgres behind a Cloudflare Tunnel.
# The database is never exposed on a public port. cloudflared publishes it as
# RELAY_DATABASE_HOST, a Cloudflare Access application guards that hostname,
# and Hyperdrive authenticates with an Access service token. Production uses
# RELAY_DATABASE_NAME as-is; every other stage gets its own database named
# `<RELAY_DATABASE_NAME>-<stage>` on the same server.
RELAY_DATABASE_HOST=code-relay-db.example.com
RELAY_DATABASE_NAME=ras-code-relay
RELAY_DATABASE_USER=ras_code_relay
RELAY_DATABASE_PASSWORD=...
RELAY_DATABASE_ACCESS_CLIENT_ID=...
RELAY_DATABASE_ACCESS_CLIENT_SECRET=...

# Required: direct connection string used only to apply migrations at deploy
# time. Migrations run from the deploy host, which reaches Postgres through
# `cloudflared access tcp` rather than Hyperdrive, so this points at whatever
# loopback port that tunnel is bound to.
RELAY_MIGRATION_DATABASE_URL=postgres://ras_code_relay:...@127.0.0.1:45432/ras-code-relay

# Required: Clerk
# Get the keys from the Clerk Dashboard under API keys. Set the JWT audience to
# the `aud` claim configured on the `ras-code-relay` JWT template.
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_JWT_AUDIENCE=ras-code-relay

# Required: PostHog receives the relay's OTLP spans. The project token is a
# public client identifier, not a secret. The endpoint defaults to PostHog
# Cloud US; set it for the EU region or a self-hosted instance.
POSTHOG_PROJECT_TOKEN=phc_...
# POSTHOG_OTLP_TRACES_URL=https://us.i.posthog.com/i/v1/traces

# Required for mobile push notifications and Live Activities: Apple Push Notification service
# Get these values from your Apple Developer account. Use `sandbox` for
# development APNs credentials and `production` for production credentials.
APNS_ENVIRONMENT=sandbox
APNS_TEAM_ID=...
APNS_KEY_ID=...
APNS_BUNDLE_ID=...
APNS_PRIVATE_KEY=...
