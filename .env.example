# Optional: RAS Connect source builds
# Copy this file to `.env`, then fill in the public values from your deployment.
# Official release builds inject the maintainers' production values. These are
# public identifiers, not secrets. Leave them unset to disable cloud features.
# Do not add server-side secrets to this file.

# Production Clerk instance. To use your own, get these from the Clerk Dashboard
# under API keys, JWT templates, and OAuth applications.
# RAS_CODE_CLERK_PUBLISHABLE_KEY=pk_live_...
# RAS_CODE_CLERK_JWT_TEMPLATE=ras-code-relay
# RAS_CODE_CLERK_CLI_OAUTH_CLIENT_ID=oauthapp_...

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in RAS_CODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# RAS_CODE_APPLE_TEAM_ID=ABC1234567
# RAS_CODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/ras-code.provisionprofile
# RAS_CODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. The `infra/relay` deploy command updates this automatically.
# RAS_CODE_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Required when RAS Connect is enabled.
# RAS_CODE_HOSTED_APP_URL=https://code.ras.sh

# Public, ingest-only mobile OpenTelemetry configuration. The PostHog project
# token is a public client identifier, so release builds embed it.
# RAS_CODE_MOBILE_OTLP_TRACES_URL=https://us.i.posthog.com/i/v1/traces
# RAS_CODE_MOBILE_OTLP_TRACES_TOKEN=phc_...
